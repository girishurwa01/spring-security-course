<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml = the "shopping list" for your project.
     Maven reads it and downloads the libraries (dependencies) you ask for. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The "parent" gives us sensible defaults and matching library versions -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
    </parent>

    <groupId>com.girish</groupId>
    <artifactId>hello</artifactId>
    <version>0.0.1</version>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Lets us build web endpoints (URLs). Includes a built-in Tomcat web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===========================================================
             LESSON 7 — TODO A: add TWO dependencies below.

             1) JPA = lets Java classes be saved as database tables
                    groupId:    org.springframework.boot
                    artifactId: spring-boot-starter-data-jpa

             2) H2 = a small database that runs INSIDE your app (in memory)
                    groupId:    com.h2database
                    artifactId: h2
                    and add one more line inside it:
                    <scope>runtime</scope>
                    (= only needed while the app RUNS, not to compile)
             =========================================================== -->
       <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <!-- Gives us the "mvn spring-boot:run" command -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
